# ==============================
# C / C++ build artifacts
# ==============================
# Compiled object files
*.x

*.pdf
*.ps
*.csv
*.png 

*.o
*.obj

# Compiled static libraries
*.a
*.lib

# Compiled dynamic/shared libraries
*.so
*.dylib
*.dll

# Executables
*.exe
*.out
*.app

# ==============================
# Build directories
# ==============================
/build/
/bin/
/Debug/
/Release/
/CMakeFiles/
/CMakeCache.txt
Makefile
cmake_install.cmake

# ==============================
# Editor / IDE files
# ==============================
# Visual Studio
*.vcxproj*
*.sln
*.user
*.ncb
*.opensdf
*.sdf

# CLion / JetBrains
.idea/
*.iml
cmake-build-*/

# Vim / Emacs / Sublime
*~
*.swp
*.swo
.DS_Store

# ==============================
# ROOT files (ignore outputs)
# ==============================
*.root
*.root~  # sometimes ROOT adds temp suffix

# ==============================
# Misc
# ==============================
*.log
*.tmp
*.bak
*.d
